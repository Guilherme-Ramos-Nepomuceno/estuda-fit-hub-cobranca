# Variáveis do serviço de Cobrança. No docker compose elas vêm do docker-compose.yml.
APP_NAME=cobranca
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cobranca
DB_USERNAME=cobranca
DB_PASSWORD=cobranca

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=database

OCTANE_SERVER=frankenphp
