# Variáveis do serviço de Cobrança. No docker compose elas vêm do docker-compose.yml.
APP_NAME=cobranca
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081

# Logs JSON no formato da ADR-003, sem os valores das consultas nos erros de banco
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER='App\Logging\FormatoJson'
LOG_LEVEL=info
DB_MASK_BINDINGS=true

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cobranca
DB_USERNAME=cobranca
DB_PASSWORD=cobranca

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=database

OCTANE_SERVER=frankenphp
OCTANE_WORKERS=4

# Fuso do negócio para regras de data (vencimento, bloqueio); banco e eventos usam UTC
COBRANCA_FUSO=America/Sao_Paulo

# Feeds de eventos (ADR-005): token que o monólito usa para ler este serviço,
# e o feed do monólito que o cobranca-consumidor lê
EVENTOS_TOKEN=
MONOLITO_EVENTOS_URL=http://monolito:8080/eventos
MONOLITO_EVENTOS_TOKEN=

# Latência simulada de cada registro de cobrança no gateway (ms)
GATEWAY_LATENCIA_MS=0
