#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../bootstrap.php';

use EstudaFitHub\Console\CobrancaRegua;
use EstudaFitHub\Console\DbMigrate;
use EstudaFitHub\Console\DbSeed;
use EstudaFitHub\Console\DbSeedVolume;
use EstudaFitHub\Console\FaturasGerarMensais;
use EstudaFitHub\Console\EventosConsumir;
use EstudaFitHub\Console\FaturasMarcarVencidas;
use EstudaFitHub\Console\ProjecaoRecalcular;
use EstudaFitHub\Console\UnidadesMigrar;

$comandos = [
    'db:migrate' => [DbMigrate::class, 'Recria o banco do zero (--se-vazio: num banco existente só aplica as migrations pendentes)'],
    'db:seed' => [DbSeed::class, 'Popula dados fictícios (--alunos=N, padrão 2000; --se-vazio)'],
    'db:seed-volume' => [DbSeedVolume::class, 'Volumetria de produção: 250 mil alunos e ~14 milhões de faturas (--alunos=N, --meses=N)'],
    'faturas:gerar-mensais' => [FaturasGerarMensais::class, 'Cron do dia 1º: gera faturas da competência ([YYYY-MM])'],
    'faturas:marcar-vencidas' => [FaturasMarcarVencidas::class, 'Cron diário: abertas vencidas viram "vencida"'],
    'cobranca:regua' => [CobrancaRegua::class, 'Cron diário: lembretes e bloqueio por inadimplência (--limite=N)'],
    'projecao:recalcular' => [ProjecaoRecalcular::class, 'Recalcula a situação financeira que a catraca lê, a partir das faturas locais'],
    'eventos:consumir' => [EventosConsumir::class, 'Consome o feed de eventos de Cobrança (--uma-vez: um lote e sai)'],
    'unidades:migrar' => [UnidadesMigrar::class, 'Canary: as faturas novas da unidade passam a ser de Cobrança (<id>)'],
    'unidades:reverter' => [static fn () => new UnidadesMigrar(reverter: true), 'Canary: devolve a unidade ao monólito (<id>)'],
];

$nome = $argv[1] ?? '';
if (!isset($comandos[$nome])) {
    fwrite(STDERR, "Uso: php bin/console <comando> [args]\n\nComandos disponíveis:\n");
    foreach ($comandos as $chave => [, $descricao]) {
        fwrite(STDERR, sprintf("  %-26s %s\n", $chave, $descricao));
    }
    exit(1);
}

$inicio = microtime(true);
$fabrica = $comandos[$nome][0];
$comando = is_string($fabrica) ? new $fabrica() : $fabrica();
$codigo = $comando->executar(array_slice($argv, 2));
printf("Concluído em %.1fs\n", microtime(true) - $inicio);
exit($codigo);
